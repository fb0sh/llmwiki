# OS
.DS_Store
Thumbs.db

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/

# IDE
.obsidian/workspace
.obsidian/cache
.vscode/

# Temp / backup
*.swp
*.swo
*~
.DS_Store?

# Node (if ever used)
node_modules/

# raw/ — 源文档不进版本控制，仅保留占位文件、assets 目录骨架和状态文件
raw/*
!raw/.gitkeep
!raw/.ingest-state.json
!raw/assets/
!raw/assets/.gitkeep

# html/ — 静态网站生成物
html/

# backups/ — 知识备份归档（llmwiki-export 产出）
# 归档本身就是"仓库之外的副本"，不该再进版本控制；且含 raw/ 源材料
backups/


